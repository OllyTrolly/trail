# Built application files
*.apk
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration files (not to be shared)
local.properties

# DS_Store is an hidden file used by macOS
.DS_Store

# Android Studio and Intellij specific
*.iml
/captures

# System files
.env

# External native build system files
.cxx/
.externalNativeBuild/

# Keystore files (keep these secure and out of Git)
*.jks
*.keystore

# Other files generated by Android Studio
*.hprof

# Ignore the .idea folder, but do not ignore all of its files.
.idea/*
!/.idea/runConfigurations.xml
!/.idea/modules.xml
!/.idea/vcs.xml